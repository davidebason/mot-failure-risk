# --- programme policy: never published ---
CLAUDE.md
.env
.env.*

# --- raw data: never committed, always re-downloadable from the source in DATA.md ---
data/raw/*
!data/raw/.gitkeep

# --- the CSVs extracted from data/raw/ by src/motrisk/extract.py: about 51 GB, rebuilt at will ---
data/extracted/

# --- the same CSVs as Parquet, written by src/motrisk/convert.py: rebuilt at will ---
data/parquet/
# --- links to a few of those files, the slice the dbt models are developed on ---
data/parquet_slice/

# --- derived data stores ---
*.duckdb
*.duckdb.wal
*.parquet

# --- dbt: build output, installed packages and logs, all regenerated by a run ---
transform/target/
transform/dbt_packages/
transform/logs/
logs/
.user.yml

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- notebooks ---
.ipynb_checkpoints/

# --- editors / os ---
.vscode/
.idea/
.DS_Store
*:Zone.Identifier

# --- Azure Function: the package copied in by function/publish.sh, and Core Tools' local secrets ---
function/motrisk/
function/.python_packages/
local.settings.json
